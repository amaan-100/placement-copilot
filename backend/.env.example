ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///placement.db
# Production example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JOBS_PROVIDER=auto
JOBS_API_URL=https://jobicy.com/api/v2/remote-jobs
JOBS_API_TIMEOUT_SECONDS=12
JOBS_FETCH_COUNT=50
JOBS_CACHE_TTL_SECONDS=3600
LLM_PROVIDER=auto
LLM_PROVIDER_LABEL=
LLM_BASE_URL=https://router.requesty.ai/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it
LLM_JSON_MODE=false
LLM_STATUS_CACHE_SECONDS=300
LLM_DAILY_REQUEST_LIMIT=180
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=600
LLM_CONTEXT_TOKENS=8192
LLM_TEMPERATURE=0.2
MAX_UPLOAD_BYTES=8388608
MAX_RESUME_CHARS=200000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=12
